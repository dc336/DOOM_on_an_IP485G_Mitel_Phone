#!/bin/ash
#
# update-progress version initial% final% wget-pipe

# not expected to be called except from update-stage, so no fancy help
if [ $# -ne 4 ]; then
 exit 0
fi

version="$1"
global_percent=$2
dcscale="$3 $2 sub mul 100 div $2 add p"
wass=`date +%s`
unset startline
finished="exit"

# read wget-pipe until it's done
while read line; do
 if [ "${line}" ]; then
  local_percent=`echo "${line}" | sed -n -e 's;.* \([0-9][0-9]*\)%.*;\1;p'`
  if [ "${local_percent}" ]; then
   global_percent=`dc ${local_percent} ${dcscale} | sed -e 's;\..*;;'`
   echo -n -e "${global_percent}%\r"
  elif echo "${line}" | grep -q -v -E '^( *=> .-.$|Connecting to |[HFTPS]* request sent|Length: |Saving to: .STDOUT| exit)'; then
   startline_candidate=`echo "${line}" | sed -n -e 's;^--\([0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]\)--  \(.*\);\2 \1;p'`
   if [ -z "${startline}" -a "${startline_candidate}" ]; then
    startline="${startline_candidate}"
   else
    finished_candidate=`echo "${line}" | sed -n -e 's;^\([0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9] [0-2][0-9]:[0-5][0-9]:[0-5][0-9]\) \(([^)]*)\) - written to stdout \(\[[^/]*\)/.*;\1 \2 \3];p'`
    if [ "${finished_candidate}" ]; then
     finished="${finished_candidate}"
    else
     echo "${global_percent}% ${line}" | logger -t update-progress -p warn
    fi
   fi
  fi
 fi
 # only report every 25 seconds
 nows=`date +%s`
 if [ ${nows} -ge $((wass+25)) ]; then
  if [ -S /tmp/cli_interface_socket ]; then
   echo firmwarestatusevent DownloadInProgress "${version}" ${global_percent} | netcat -U /tmp/cli_interface_socket 2>&1 >/dev/null
  fi
  wass=${nows}
  echo
 fi
done < $4
echo "${startline#* }..${finished} ${startline%% *}" | logger -t update-progress -p info
