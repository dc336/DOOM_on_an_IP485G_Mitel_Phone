#!/bin/ash
failClean () {
 echo "${@}"
 rm /tmp/ftkv$$-*
 exit 1
}

pairs=$(($#/2))
if [ $# -eq 0 -o $((pairs*2)) -ne $# ]; then
 echo 'Usage: ${0##*/} key val [key val]*'
 exit 1
fi

boot1Origin=`cat /proc/manuf/boot1Origin`
boot1Size=`cat /proc/manuf/boot1Size`
if [ -z "$boot1Origin" -o -z "$boot1Size" ]; then
 failClean "failing ${0##*/}: missing /proc/manuf/boot1..."
fi

boot2Origin=`cat /proc/manuf/boot2Origin`
boot2Size=`cat /proc/manuf/boot2Size`
if [ -z "$boot2Origin" -o -z "$boot2Size" ]; then
 failClean "failing ${0##*/}: missing /proc/manuf/boot2..."
fi

configOrigin=`cat /proc/manuf/configOrigin`
configSize=`cat /proc/manuf/configSize`
if [ -z "$configOrigin" -o -z "$configSize" ]; then
 failClean "failing ${0##*/}: missing /proc/manuf/config..."
fi
# adjust config to include @#()CONFIG:\n
configOrigin=$((configOrigin-12))
configSize=$((configSize+12))

# boot1 must be first, but config & boot2 can be in either order
lowerBound=$((boot1Size+$boot1Origin))
upperBound=131071
if [ $boot2Origin -lt $configOrigin ]; then
  lowerBound=$((boot2Size+$boot2Origin))
  lowerBound=$((lowerBound+2047))
  lowerBound=$((lowerBound/2048))
  lowerBound=$((lowerBound*2048))
else
  upperBound=$((boot2Origin-1))
fi

# capture current strings
dd if=/dev/mtd0 bs=1 skip=$configOrigin count=$configSize 2>/dev/null >/tmp/ftkv$$-tagged-keys

# collect and verify changes
while [ $# -ne 0 ]; do
 if grep -q "^$1=" /tmp/ftkv$$-tagged-keys; then
  if [ -z "$2" ]; then
   echo -n "DELETE  "
   grep "^$1=" /tmp/ftkv$$-tagged-keys
   grep -v "^$1=" /tmp/ftkv$$-tagged-keys >/tmp/ftkv$$-tmp
  else
   echo -n "CHANGE  "
   grep "^$1=" /tmp/ftkv$$-tagged-keys | tr -d \\n
   echo -n " TO "
   echo "$2"
   sed -e "s;^$1=.*;$1=$2;" /tmp/ftkv$$-tagged-keys >/tmp/ftkv$$-tmp
  fi
  mv /tmp/ftkv$$-tmp /tmp/ftkv$$-tagged-keys
 else
  echo    "NEW KEY $1=$2"
  echo "$1=$2" >>/tmp/ftkv$$-tagged-keys
 fi
 shift 2
done

dd if=/dev/mtd0 bs=1 skip=$configOrigin count=$configSize 2>/dev/null | cmp -s /tmp/ftkv$$-tagged-keys && echo 'No key val changes, so block 0 not rewritten' && exit 0

# write new tagged-keys
configOriginNew=$configOrigin
configSizeNew=`cat /tmp/ftkv$$-tagged-keys | wc -c`
configPadSize=$configSize
while [ $configOriginNew -ge $lowerBound ]; do
 configSizeMax=$((upperBound-$configOriginNew))
 [ $configSizeNew -le $configSizeMax ] && break
 configOriginNew=$((configOriginNew-2048))
 configPadSize=$((configPadSize+2048))
done
[ $configOriginNew -lt $lowerBound ] && failClean "Error: No room to store config growth from $configSize to $configSizeNew"
  
dd if=/dev/mtd0 ibs=2048 count=64 of=/tmp/ftkv$$-block0 2>/dev/null
[ $? -ne 0 ] && failClean "failing ${0##*/}: cannot read original block0"

if [ $configOriginNew -ne $configOrigin ]; then
 echo "config grew too big for its prior location..."
 echo "boot1 $boot1Origin..$((boot1Origin+$boot1Size-1))"
 echo "boot2 $boot2Origin..$((boot2Origin+$boot2Size-1))"
 echo "config $configOrigin..$((configOrigin+$configSizeNew)) won't fit"
 echo "OK to move config to $configOriginNew..$((configOriginNew+$configSizeNew))? [NO/yes]"
 read confirm
 [ "$confirm" != "yes" ] && failClean "Operation not confirmed, abandoning changes."
fi
  
# create new image
dd if=/tmp/ftkv$$-tagged-keys bs=1 count=$configSizeNew seek=$configOriginNew of=/tmp/ftkv$$-block0 conv=notrunc 2>/dev/null
if [ $configSizeNew -lt $configPadSize ]; then
 padOrigin=$((configOriginNew+$configSizeNew))
 padSize=$((configPadSize-$configSizeNew))
 dd if=/dev/zero bs=1 count=$padSize seek=$padOrigin of=/tmp/ftkv$$-block0 conv=notrunc 2>/dev/null
fi

dd if=/dev/mtd0 ibs=2048 count=64 2>/dev/null | cmp -s /tmp/ftkv$$-block0 && echo 'No block changes, so block 0 not rewritten' && exit 0

echo    "Block 0 has a limited number of rewrite cycles, so you must"
echo -n "explicitly confirm that you want to perform this operation [NO/yes]: "
read confirm
[ "$confirm" != "yes" ] && failClean "Operation not confirmed, abandoning changes."

echo 'rewriting block0!'
# erase block zero
flash_eraseall /dev/mtd0
# write block zero
nandwrite /dev/mtd0 /tmp/ftkv$$-block0
echo 'block0 rewritten, reboot to pick up new /proc/manuf/ entries'
rm /tmp/ftkv$$-*
