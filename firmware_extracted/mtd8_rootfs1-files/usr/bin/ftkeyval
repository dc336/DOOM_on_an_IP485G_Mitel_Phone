#!/bin/ash
usage () {
 echo 'Usage: ftkeyval key val [key val]*'
 exit 1
}
pairs=$(($#/2))
if [ $# -eq 0 -o $((pairs*2)) -ne $# ]; then
 usage
fi

configOrigin=`cat /proc/manuf/configOrigin`
configSize=`cat /proc/manuf/configSize`
if [ -z "$configOrigin" -o -z "$configSize" ]; then
 echo "failing $0: missing /proc/manuf/config..."
fi

# capture current strings
dd if=/dev/mtd0 bs=1 skip=$configOrigin count=$configSize 2>/dev/null >/tmp/ftkv$$-tagged-keys

# collect and verify changes
while [ $# -ne 0 ]; do
 if grep -q "^$1=" /tmp/ftkv$$-tagged-keys; then
  if [ -z "$2" ]; then
   echo -n "DELETE  "
   grep "^$1=" /tmp/ftkv$$-tagged-keys
   grep -v "^$1=" /tmp/ftkv$$-tagged-keys >/tmp/ftkv$$-tmp
  else
   echo -n "CHANGE  "
   grep "^$1=" /tmp/ftkv$$-tagged-keys | tr -d \\n
   echo -n " TO "
   echo "$2"
   sed -e "s;^$1=.*;$1=$2;" /tmp/ftkv$$-tagged-keys >/tmp/ftkv$$-tmp
  fi
  mv /tmp/ftkv$$-tmp /tmp/ftkv$$-tagged-keys
 else
  echo    "NEW KEY $1=$2"
  echo "$1=$2" >>/tmp/ftkv$$-tagged-keys
 fi
 shift 2
done

dd if=/dev/mtd0 bs=1 skip=$configOrigin count=$configSize 2>/dev/null | cmp -s /tmp/ftkv$$-tagged-keys && echo 'No key val changes, so block 0 not rewritten' && exit 0

echo    "Block 0 has a limited number of rewrite cycles, so you must"
echo -n "explicitly confirm that you want to perform this operation [NO/yes]: "
read confirm
if [ "$confirm" != "yes" ]; then
 echo   "Operation not confirmed, abandoning changes."
 exit 0
fi

# write new tagged-keys
configSizeNew=`cat /tmp/ftkv$$-tagged-keys | wc -c`
[ $configSizeNew -gt 4084 ] && { echo "failing $0: keys exceed 4K storage allocation"; exit 1; }
dd if=/dev/mtd0 ibs=2048 count=64 of=/tmp/ftkv$$-block0 2>/dev/null
[ $? -ne 0 ] && { echo "failing $0: cannot read original block0"; exit 1; }

# create new image
dd if=/tmp/ftkv$$-tagged-keys bs=1 count=$configSizeNew seek=$configOrigin of=/tmp/ftkv$$-block0 conv=notrunc 2>/dev/null
if [ $configSizeNew -lt $configSize ]; then
 padOrigin=$((configOrigin+$configSizeNew))
 padSize=$((configSize-$configSizeNew))
 dd if=/dev/zero bs=1 count=$padSize seek=$padOrigin of=/tmp/ftkv$$-block0 conv=notrunc 2>/dev/null
fi

dd if=/dev/mtd0 ibs=2048 count=64 2>/dev/null | cmp -s /tmp/ftkv$$-block0 && echo 'No block changes, so block 0 not rewritten' && exit 0

echo 'rewriting block0!'
# erase block zero
flash_eraseall /dev/mtd0
# write block zero
nandwrite /dev/mtd0 /tmp/ftkv$$-block0
echo 'block0 rewritten, reboot to pick up new /proc/manuf/ entries'
rm /tmp/ftkv$$-*
